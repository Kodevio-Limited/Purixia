# Purixia BD — backend environment template
#
# Copy to `.env` for LOCAL development only (`cp .env.example .env`).
# `.env` is git-ignored and must never be committed.
#
# In production these values are supplied by the orchestrator (Dokploy →
# Environment), not by a file. See DEPLOYMENT.md.

# ── Django ────────────────────────────────────────────────────────────────────
# dev (default) | production | test
DJANGO_ENV=dev

# REQUIRED in production. Must be a unique random string of at least 32
# characters, or the app refuses to boot.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-random-32-plus-character-value

# Comma-separated. REQUIRED in production and must NOT be "*".
ALLOWED_HOSTS=purixiabd.com,www.purixiabd.com,admin.purixiabd.com

# ── Production database (Postgres, internal "db" service) ────────────────────
# Single source of credentials: POSTGRES_PASSWORD. DB_* fall back to POSTGRES_*.
# REQUIRED in production — boot fails without a password.
DB_NAME=purixia
DB_USER=purixia
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
POSTGRES_DB=purixia
POSTGRES_USER=purixia
POSTGRES_PASSWORD=

# ── Admin account (manual — not managed by env) ──────────────────────────────
# No ADMIN_* variables are used. Create the superuser once inside the backend
# container and change its password in /admin/ or with `changepassword`:
#   python manage.py createsuperuser --settings=core.settings.prod

# ── Origins ──────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://purixiabd.com,https://www.purixiabd.com
CSRF_TRUSTED_ORIGINS=https://purixiabd.com,https://www.purixiabd.com,https://admin.purixiabd.com

# ── Shared cache (required once you run more than one backend replica) ───────
# Powers rate limiting across replicas.
REDIS_URL=redis://redis:6379/0

# ── Delivery fees (server-side, BDT) ────────────────────────────────────────
DELIVERY_CHARGE_INSIDE=60
DELIVERY_CHARGE_OUTSIDE=120

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Rate limits (safety nets; raise for carrier-NAT-heavy traffic) ──────────
THROTTLE_ANON=240/min
THROTTLE_USER=4000/hour
THROTTLE_AUTH=20/min

# Order placement, per signed-in user. A real customer never places 10 orders
# in an hour, a script does it in seconds.
THROTTLE_ORDER=10/hour

# ── COD abuse protection ─────────────────────────────────────────────────────
# How many orders that are still awaiting fulfilment (pending/confirmed) one
# account may hold at once. Cash on delivery means an unpaid order is a real
# commitment, so this keeps one account from stockpiling them. Set 0 to disable.
MAX_OPEN_ORDERS=1

# ── Transactional email (password reset + email verification) ───────────────
# Dev default is the console backend: links print to the terminal, no SMTP
# needed. In production set EMAIL_HOST (plus credentials) to switch the app
# to real SMTP. Sending is best-effort either way: a broken mail server never
# blocks signup, login or ordering.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Purixia BD <no-reply@purixiabd.com>

# Storefront base URL used to build the links inside those emails.
FRONTEND_URL=http://localhost:3000

# How long a reset / verification link stays valid (seconds; default 24h).
# Reset links are additionally single-use: changing the password kills the
# token, and confirming an address kills the verification token.
PASSWORD_RESET_TIMEOUT=86400

# Sending-endpoint rate limit (password-reset requests). Each hit costs a
# message and could target someone else's inbox, so keep this low.
THROTTLE_EMAIL_SEND=5/hour

# ── Sentry error reporting (opt-in) ──────────────────────────────────────────
# Empty = disabled entirely (the SDK is never even imported). Set SENTRY_DSN
# to enable backend error + sampled trace reporting. Frontend uses
# NEXT_PUBLIC_SENTRY_DSN (see frontend/.env.example).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Refresh-token cookie ─────────────────────────────────────────────────────# The refresh token travels only as this HttpOnly cookie (JS cannot read it);
# the short-lived access token stays in memory in the storefront. SECURE must
# stay False on plain-HTTP localhost (browsers discard Secure cookies there);
# production forces it back on. SAMESITE=Lax is correct while both sites share
# purixiabd.com; switch to None only if the frontend moves to another site.
REFRESH_COOKIE_NAME=purixia_refresh
REFRESH_COOKIE_PATH=/api/auth/
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_DOMAIN=
