DJANGO_ENV=production

SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=purixiabd.com,www.purixiabd.com,admin.purixiabd.com

# ── Production database (Postgres, internal "db" service) ────────────────────
# Single source of credentials: POSTGRES_PASSWORD. DB_* fall back to POSTGRES_*.
DB_NAME=purixia
DB_USER=purixia
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
POSTGRES_DB=purixia
POSTGRES_USER=purixia
POSTGRES_PASSWORD=

# ── Bootstrap admin (entrypoint ensure_admin; first boot only) ───────────────
# Set ADMIN_RESET_PASSWORD=1 on first deploy, then remove it (or set to 0).
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=0

CORS_ALLOWED_ORIGINS=https://purixiabd.com,https://www.purixiabd.com
CSRF_TRUSTED_ORIGINS=https://purixiabd.com,https://www.purixiabd.com,https://admin.purixiabd.com

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
