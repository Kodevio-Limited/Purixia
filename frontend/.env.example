# Purixia BD — frontend environment template
#
# Copy to .env.local for local development (`cp .env.example .env.local`).
# These values are inlined into the browser bundle at BUILD time, so changing
# them requires a rebuild — never put a secret in this file.

# Base URL of the Django API. Must be reachable from the user's browser.
NEXT_PUBLIC_API_URL=https://admin.purixiabd.com

# Browser error reporting (Sentry). Empty = disabled; the app behaves exactly
# as before. Set to the DSN and rebuild to enable. NOT a secret (it ships in
# the browser bundle), but keep it out of screenshots all the same.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=production
